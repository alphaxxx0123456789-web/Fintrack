# Serveur
PORT=3000
NODE_ENV=development

# Base de données (SQLite par défaut — aucun serveur externe requis)
DB_PATH=fintrack.sqlite

# JWT — obligatoire, le serveur refuse de démarrer sans cette variable.
# Valeur ci-dessous générée avec `openssl rand -hex 32` : à usage local uniquement,
# régénérez-en une nouvelle (et gardez-la secrète) pour tout déploiement réel.
JWT_SECRET=f25de6967e4b9d7202325ba2936467b2ffa2f51f15be8e9dbed676381efb4204
JWT_EXPIRES_IN=1d

# API externe — ExchangeRate (open.er-api.com, gratuite, sans clé)
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest

# CORS — URL du frontend FinTrack
FRONTEND_URL=http://localhost:5173
